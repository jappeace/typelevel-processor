cabal-version:      3.0

name:           typelevel-processor
version:        1.0.0
synopsis:       An 8 bit processor built from NAND gates, evaluated by the type checker
homepage:       https://github.com/jappeace/typelevel-processor#readme
bug-reports:    https://github.com/jappeace/typelevel-processor/issues
author:         Jappie Klooster
maintainer:     hi@jappie.me
copyright:      2020 Jappie Klooster
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    Readme.md
    LICENSE
extra-doc-files:
    Changelog.md

source-repository head
  type: git
  location: https://github.com/jappeace/typelevel-processor

common common-options
  default-extensions:
      EmptyCase
      FlexibleContexts
      FlexibleInstances
      InstanceSigs
      MultiParamTypeClasses
      LambdaCase
      MultiWayIf
      NamedFieldPuns
      TupleSections
      DeriveFoldable
      DeriveFunctor
      DeriveGeneric
      DeriveLift
      DeriveTraversable
      DerivingStrategies
      GeneralizedNewtypeDeriving
      StandaloneDeriving
      OverloadedStrings
      TypeApplications
      NumericUnderscores
      ImportQualifiedPost

  ghc-options:
    -O2 -Wall -Werror -Wincomplete-uni-patterns
    -Wincomplete-record-updates -Widentities -Wredundant-constraints
    -Wcpp-undef -fwarn-tabs -Wpartial-fields
    -fdefer-diagnostics -Wunused-packages
    -fenable-th-splice-warnings
    -fno-omit-yields

  build-depends:
      base >=4.9.1.0 && <4.22.0

  default-language: Haskell2010

library
  import: common-options
  exposed-modules:
      ArithmeticLogicUnit
      Arithmetics
      Assembler
      Bytewise
      Computer
      ControlUnit
      FizzBuzz
      LogicGates
      Memory
      Plumbing
      Processor
      RandomAccessMemory
      Reflection
  hs-source-dirs:
      src

executable exe
  import: common-options
  main-is: Main.hs
  hs-source-dirs:
      app
  build-depends:
      typelevel-processor
  ghc-options: -Wno-unused-packages -threaded -rtsopts "-with-rtsopts=-N -M7G -T -Iw10"

test-suite unit
  import: common-options
  type: exitcode-stdio-1.0
  main-is: Test.hs
  other-modules:
      NatFizzBuzz
  hs-source-dirs:
      test
  build-depends:
      tasty,
      tasty-hunit,
      typelevel-processor
  ghc-options: -Wno-unused-packages -threaded -rtsopts "-with-rtsopts=-N -M7G -T -Iw10"
